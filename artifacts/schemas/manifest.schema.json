{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact manifest (manifest_version 1.0)",
  "description": "artifacts/manifest.json: the single source of truth for what the API serves and what the scheduled job promotes. Paths are relative to artifacts/.",
  "type": "object",
  "required": [
    "manifest_version",
    "updated_at_utc",
    "feature_version",
    "champion",
    "challenger",
    "evaluations",
    "data_through"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "updated_at_utc": {
      "type": "string"
    },
    "feature_version": {
      "type": "string"
    },
    "champion": {
      "$ref": "#/$defs/slot"
    },
    "challenger": {
      "$ref": "#/$defs/slot"
    },
    "tiers_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "eval_id": {
      "type": "string"
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eval_id",
          "kind",
          "path"
        ],
        "properties": {
          "eval_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "frozen_test",
              "out_of_sample_season"
            ]
          },
          "season": {
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^eval/"
          }
        }
      }
    },
    "data_through": {
      "type": "object",
      "required": [
        "season",
        "period"
      ],
      "properties": {
        "season": {
          "type": "integer"
        },
        "period": {
          "type": "integer"
        }
      }
    },
    "predictions": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "string",
          "pattern": "^predictions/"
        }
      }
    },
    "last_run": {
      "type": "object",
      "required": [
        "run_id",
        "at_utc",
        "action",
        "reasons",
        "season",
        "period"
      ],
      "properties": {
        "action": {
          "enum": [
            "PUBLISH",
            "HOLD",
            "PROMOTE"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": [
        "model_version",
        "candidate"
      ],
      "properties": {
        "model_version": {
          "type": "string"
        },
        "candidate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      }
    }
  }
}
