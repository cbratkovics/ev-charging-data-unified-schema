{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drift run report (drift_report_version 1.1)",
  "description": "artifacts/drift/<run_id>.json, written by the scheduled job on every run whose contracts passed (HOLD, WARN and OK alike): the per-cohort PSI reports the publish/hold decision was made on. Per cohort: PSI per feature of the last N played periods against the training reference, the status the rule derives, and which reference was used (bucket inside a season, matched across a season boundary). HOLD = median monitored PSI above thresholds.hold_median with at least three monitored features, or at least thresholds.min_severe_features features above thresholds.severe; WARN = any feature above hold_median or median above warn. thresholds.calibrated / calibrated is false until the calibration recipe in eval/drift.py has been followed; the job never HOLDs on drift while it is false.",
  "type": "object",
  "required": [
    "drift_report_version",
    "run_id",
    "at_utc",
    "season",
    "period",
    "model_version",
    "window_periods_max",
    "calibrated",
    "status",
    "cohorts"
  ],
  "properties": {
    "drift_report_version": {
      "const": "1.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-"
    },
    "at_utc": {
      "type": "string"
    },
    "season": {
      "type": "integer"
    },
    "period": {
      "type": "integer",
      "minimum": 1
    },
    "model_version": {
      "type": "string"
    },
    "window_periods_max": {
      "type": "integer",
      "minimum": 1
    },
    "calibrated": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ok",
        "warn",
        "hold"
      ]
    },
    "cohorts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/cohort_report"
      }
    }
  },
  "$defs": {
    "cohort_report": {
      "type": "object",
      "required": [
        "n",
        "psi",
        "monitored",
        "median_monitored",
        "flagged",
        "severe",
        "thresholds",
        "status",
        "reference"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "psi": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "monitored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "median_monitored": {
          "type": [
            "number",
            "null"
          ]
        },
        "flagged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severe": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thresholds": {
          "type": "object",
          "required": [
            "warn",
            "hold_median",
            "severe",
            "min_severe_features",
            "calibrated"
          ],
          "properties": {
            "calibrated": {
              "type": "boolean"
            }
          }
        },
        "status": {
          "enum": [
            "ok",
            "warn",
            "hold"
          ]
        },
        "reference": {
          "description": "How the reference deciles were chosen: bucket = the training-time period-of-season bucket of the newest window period; matched = training-season rows at the window's own period positions (used when the window crosses a season boundary)",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "mode",
                "window_seasons",
                "window_periods",
                "reference_periods",
                "training_seasons"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "bucket",
                    "matched"
                  ]
                },
                "window_seasons": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "window_periods": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "reference_periods": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "bucket": {
                  "type": "integer"
                },
                "training_seasons": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "n_reference_rows": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fallback": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
