{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model version metadata",
  "description": "artifacts/models/<model_version>/metadata.json, written once by models.train.train_all: versions, split, input hash, code commit, per-cohort sample sizes, candidate metrics and the drift reference.",
  "type": "object",
  "required": [
    "model_version",
    "feature_version",
    "sklearn_version",
    "data_library",
    "trained_at_utc",
    "data_through",
    "seasons",
    "target",
    "input_sha256",
    "input_rows",
    "code_commit",
    "interval_method",
    "candidates",
    "cohorts"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]{8}-"
    },
    "feature_version": {
      "type": "string"
    },
    "sklearn_version": {
      "type": "string"
    },
    "data_library": {
      "type": "string"
    },
    "trained_at_utc": {
      "type": "string"
    },
    "data_through": {
      "type": "object",
      "required": [
        "season",
        "period"
      ],
      "properties": {
        "season": {
          "type": "integer"
        },
        "period": {
          "type": "integer"
        }
      }
    },
    "seasons": {
      "type": "object",
      "required": [
        "train",
        "val",
        "test"
      ]
    },
    "target": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_rows": {
      "type": "integer",
      "minimum": 1
    },
    "code_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "interval_method": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cohorts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "n_train",
          "n_val",
          "n_test",
          "n_features",
          "features",
          "champion",
          "candidates",
          "drift_reference"
        ],
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "champion": {
            "type": "string"
          },
          "challenger": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "val_mae",
                "test_mae",
                "residual_quantiles",
                "top_feature_importance",
                "hyperparameters"
              ],
              "properties": {
                "val_mae": {
                  "type": "number"
                },
                "test_mae": {
                  "type": "number"
                },
                "residual_quantiles": {
                  "type": "object",
                  "required": [
                    "q",
                    "values"
                  ]
                },
                "top_feature_importance": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "hyperparameters": {
                  "type": "object"
                }
              }
            }
          },
          "drift_reference": {
            "type": "object",
            "required": [
              "bucket_periods",
              "global",
              "buckets"
            ],
            "properties": {
              "bucket_periods": {
                "type": "integer"
              },
              "global": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 11,
                  "maxItems": 11
                }
              },
              "buckets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 11,
                    "maxItems": 11
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
