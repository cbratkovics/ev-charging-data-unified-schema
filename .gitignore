# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# secrets: only the placeholder example is tracked
.env
.env.*
!.env.example

# downloaded and landed source files (regenerated by `make ingest`; never committed except
# where docs/DATA_SOURCES.md records a licence that permits it)
data/raw/
data/landed/

# dbt local warehouse, build outputs, slim-build state
.duckdb/
.dbt-state/
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Committed on purpose: run artifacts (drift, reconciliation, findings inputs) and exports.
!artifacts/**
!exports/**
# A global ~/.gitignore that ignores `*.sql` would hide the dbt project; re-include it.
!dbt/**/*.sql
